# Copy to .env and adjust. Paths are relative to the project root unless absolute.

# Folder the IV4 / FTP server writes into
IV4_INCOMING_DIR=data/incoming
IV4_PROCESSING_DIR=data/processing
IV4_ERROR_DIR=data/error
IV4_UPLOADED_DIR=data/uploaded
IV4_DATABASE_PATH=data/database/iv4.db
IV4_LOG_DIR=logs

# Ingestion
IV4_SCAN_INTERVAL=1.0        # seconds between folder scans (events also wake it up)
IV4_SETTLE_SECONDS=1.5       # file must be unchanged this long before processing
IV4_GROUP_TIMEOUT=120        # incomplete group -> data/error after N seconds
IV4_EXPECTED_IMAGES=1
IV4_EXPECTED_TEXTS=1        # real IV4: <name>.jpg + <name>.txt
IV4_VERIFY_IMAGES=true       # open each JPG with Pillow to detect truncated files
IV4_USE_POLLING=false        # true if incoming dir is a network share (SMB)

# IV4 source
IV4_DATE_FORMAT=%d/%m/%Y     # 'Time and Date' in TXT; use %m/%d/%Y if the sensor is set to MM/DD
IV4_SENSOR_ID=IV4-01         # stored as camera_id (TXT has no sensor id)
IV4_MACHINE_ID=

# Analysis: sensor judgement (Total Status + per-tool OK/NG) is used.
# Optional extra rules, empty = off:
IV4_SCORE_THRESHOLD=         # FAIL if lowest tool value < this
IV4_CONFIDENCE_THRESHOLD=

# Logging
IV4_LOG_LEVEL=INFO
IV4_LOG_MAX_BYTES=10485760
IV4_LOG_BACKUP_COUNT=10

# Online storage - Google Drive (Phase 7)
# NOTE: a Google API key CANNOT upload. Use OAuth (personal Gmail) or a service account.
IV4_UPLOAD_ENABLED=false
IV4_UPLOAD_BACKEND=gdrive            # gdrive | mock
IV4_UPLOAD_INTERVAL=30
IV4_UPLOAD_BATCH=50
IV4_GDRIVE_AUTH=oauth                # oauth | service_account
IV4_GDRIVE_CREDENTIALS=credentials/client_secret.json
IV4_GDRIVE_TOKEN=credentials/token.json
IV4_GDRIVE_FOLDER_ID=                # empty = agent creates "IV4 Data Agent" folder (required for service_account)
IV4_GDRIVE_ROOT_NAME=IV4 Data Agent
