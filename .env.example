# Copy to .env and adjust. Paths are relative to the project root unless absolute.

# Folder the IV4 / FTP server writes into
IV4_INCOMING_DIR=data/incoming
IV4_PROCESSING_DIR=data/processing
IV4_ERROR_DIR=data/error
IV4_UPLOADED_DIR=data/uploaded
IV4_ARCHIVE_DIR=data/archive     # finished inspections: <date>/<OK|NG|UNKNOWN>/<uid>/ (can be another drive)
IV4_DATABASE_PATH=data/database/iv4.db
IV4_LOG_DIR=logs

# Ingestion
IV4_SCAN_INTERVAL=1.0        # seconds between folder scans (events also wake it up)
IV4_SETTLE_SECONDS=1.5       # file must be unchanged this long before processing
IV4_GROUP_TIMEOUT=120        # incomplete group -> data/error after N seconds
IV4_EXPECTED_IMAGES=1
IV4_EXPECTED_TEXTS=1        # real IV4: <name>.jpg + <name>.txt
IV4_VERIFY_IMAGES=true       # open each JPG with Pillow to detect truncated files
IV4_USE_POLLING=false        # true if incoming dir is a network share (SMB)
IV4_WORKERS=0                # file-work threads, 0 = auto (2 x cores, max 16)
IV4_BATCH_SIZE=200           # inspections per database transaction

# IV4 source
IV4_TIME_OFFSET_HOURS=0       # sensor clock wrong and cannot be fixed? sensor 2 h ahead -> -2 (applies to NEW files only)
IV4_DATE_FORMAT=%d/%m/%Y     # 'Time and Date' in TXT; use %m/%d/%Y if the sensor is set to MM/DD
# Each sensor sends to its own FTP folder: incoming/IV4-01/, incoming/IV4-02/
# (sensor name = folder name). Empty = use every subfolder of incoming/.
IV4_SENSORS=IV4-01,IV4-02
IV4_SENSOR_ID=IV4-01         # name for files dropped directly in incoming/ (single-sensor setups only)
IV4_MACHINE_ID=

# Analysis: sensor judgement (Total Status + per-tool OK/NG) is used.
# Optional extra rules, empty = off:
IV4_SCORE_THRESHOLD=         # FAIL if lowest tool value < this
IV4_CONFIDENCE_THRESHOLD=

# Logging
IV4_LOG_LEVEL=INFO
IV4_LOG_MAX_BYTES=10485760
IV4_LOG_BACKUP_COUNT=10

# Retention (days, 0 = keep forever). Full-rate output ~8 GB per sensor per RUNNING hour of images
# (110 KB x 20/s). With unknown running hours, rely on the disk guard below and set NG retention.
# Limited disk + everything on Google Drive? e.g. OK=2, NG=30. While upload is ON, a folder that is
# still waiting for upload is kept (up to 14 more days), so nothing is deleted before it is sent.
IV4_RETENTION_OK_DAYS=0
IV4_RETENTION_NG_DAYS=0
IV4_RETENTION_ROWS_DAYS=0      # per-inspection DB rows; hourly metrics are always kept
IV4_MIN_FREE_GB=20             # below this: delete OLDEST OK images (hour by hour) + warning
IV4_DISK_PRUNE_OK=true         # NG/UNKNOWN images are never deleted by the disk guard
IV4_DISK_CHECK_INTERVAL=300

# Online storage - Google Drive (Phase 7)
# NOTE: a Google API key CANNOT upload. Use OAuth (personal Gmail) or a service account.
IV4_UPLOAD_ENABLED=false
IV4_UPLOAD_BACKEND=gdrive            # gdrive | mock
IV4_UPLOAD_STATUSES=FAIL,UNKNOWN     # which inspections to upload; ALL = everything (not realistic at full rate)
IV4_UPLOAD_INTERVAL=30
IV4_UPLOAD_BATCH=50
IV4_GDRIVE_AUTH=oauth                # oauth | service_account
IV4_GDRIVE_CREDENTIALS=credentials/client_secret.json
IV4_GDRIVE_TOKEN=credentials/token.json
IV4_GDRIVE_FOLDER_ID=                # empty = agent creates "IV4 Data Agent" folder (required for service_account)
IV4_GDRIVE_ROOT_NAME=IV4 Data Agent
IV4_SHEETS_ENABLED=false             # live summary dashboard in Google Sheets (needs the Google sign-in above + Sheets API enabled)
IV4_SHEETS_INTERVAL=60               # seconds between updates (min 15)
IV4_SHEETS_TITLE=IV4 Dashboard
